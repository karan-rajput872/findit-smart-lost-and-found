# ==============================================================================
# FindIt — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / React)
# ------------------------------------------------------------------------------
VITE_APP_NAME="FindIt"
VITE_APP_TAGLINE="Don't lose hope. Find what matters."
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
VITE_DEMO_MODE="false"

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT="development"
PROJECT_NAME="FindIt API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# CORS configuration (comma-separated or JSON list of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# JWT Authentication Security Settings
# In production, generate a secure 64-character random secret key
JWT_SECRET_KEY="generate-a-secure-random-secret-key-for-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Mode A: SQLite (Default Local Development)
# Leave DATABASE_URL blank or unset to automatically use backend/data/findit.db
# DATABASE_URL=""

# Mode B: PostgreSQL (Neon Cloud or Docker Production)
# DATABASE_URL="postgresql+psycopg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DBNAME>?sslmode=require"

# Mode C: Local PostgreSQL container
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changethis_in_production"
POSTGRES_DB="findit_db"
