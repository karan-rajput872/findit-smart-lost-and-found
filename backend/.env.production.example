# ==============================================================================
# FindIt Backend — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env or paste these key-value pairs into your cloud dashboard
# (e.g. Render Dashboard -> Environment Variables).
# DO NOT COMMIT ACTUAL PASSWORDS OR SECRET KEYS TO GIT.

PROJECT_NAME="FindIt API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"

# ==============================================================================
# CORS ORIGINS
# ==============================================================================
# Set your production frontend URL(s) without trailing slashes.
# Can be a JSON array string or comma-separated list.
# Example: BACKEND_CORS_ORIGINS=["https://findit-campus.vercel.app"]
BACKEND_CORS_ORIGINS=["https://YOUR-FRONTEND-APP.vercel.app"]

# ==============================================================================
# JWT AUTHENTICATION SECURITY SETTINGS
# ==============================================================================
# REQUIRED IN PRODUCTION: Generate a random 64-character secret key.
# In PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 64 | ForEach-Object {[char]$_})
# In Python: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="REPLACE_WITH_A_SECURE_64_CHAR_RANDOM_SECRET_KEY"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# PRODUCTION POSTGRESQL DATABASE (NEON CLOUD)
# ==============================================================================
# Paste your Neon PostgreSQL connection string from Neon console.
# Example: postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon connection pool parameters (tuned for Neon Free Tier 20-connection ceiling)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# ==============================================================================
# PERSISTENT IMAGE STORAGE (CLOUDINARY)
# ==============================================================================
# Free tier from https://cloudinary.com/
# Found on Cloudinary Dashboard:
CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"
# Or provide CLOUDINARY_URL directly:
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# ==============================================================================
# API DOCUMENTATION (SWAGGER / REDOC)
# ==============================================================================
# Set to true to allow public interactive API docs at /docs, or false to hide
ENABLE_DOCS="true"
