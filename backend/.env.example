# FindIt Backend Environment Configuration
PROJECT_NAME="FindIt API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# CORS configuration (list of allowed frontend origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Set a strong, cryptographically random secret string in your private backend/.env
JWT_SECRET_KEY="generate-a-secure-random-secret-key-for-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# GOOGLE IDENTITY SERVICES AUTHENTICATION
# ------------------------------------------------------------------------------
# Expected Google OAuth Web Client ID (matches frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# 1. PRIMARY LOCAL DATABASE: SQLite (DEFAULT)
# If DATABASE_URL is omitted or left empty, FindIt automatically creates and uses:
# backend/data/findit.db (persistent file storage, zero configuration required).
#
# 2. NEON CLOUD POSTGRESQL (OPTIONAL)
# When deploying or connecting to Neon Cloud PostgreSQL, provide your connection string:
# DATABASE_URL="postgresql+psycopg://<USER>:<PASSWORD>@<HOST>.neon.tech/<DBNAME>?sslmode=require"
#
# 3. CUSTOM SQLITE PATH (OPTIONAL)
# DATABASE_URL="sqlite:///C:/path/to/custom/findit.db"

# ------------------------------------------------------------------------------
# LOCAL POSTGRESQL CREDENTIALS (OPTIONAL ALTERNATIVE)
# ------------------------------------------------------------------------------
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changethis_in_production"
POSTGRES_DB="findit_db"
