# ==============================================================================
# FindIt Frontend — Production Environment Configuration Template
# ==============================================================================
# Set these variables in your Vercel Project Settings -> Environment Variables.

VITE_APP_NAME="FindIt"
VITE_APP_TAGLINE="Don't lose hope. Find what matters."

# Production API Base URL (Render backend URL with /api/v1 suffix)
# Example: https://findit-backend.onrender.com/api/v1
VITE_API_BASE_URL="https://YOUR-BACKEND-APP.onrender.com/api/v1"

# Production demo toggle (false in production)
VITE_DEMO_MODE="false"
